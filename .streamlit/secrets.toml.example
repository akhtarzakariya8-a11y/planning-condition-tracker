# Copy the parts you need into Streamlit Cloud → your app → Settings → Secrets.
# Locally, keep the same values in .env (ANTHROPIC_API_KEY, SUPABASE_URL, ...) or in
# .streamlit/secrets.toml, which is git-ignored. NEVER commit real values.

ANTHROPIC_API_KEY = "sk-ant-..."

# ----- Saved projects (Phase 4) -----
# Supabase → Project Settings → API. Run supabase/schema.sql once first.
# The service_role key stays on the server; it is never sent to the browser.
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_KEY = "eyJ..."

# ----- Google sign-in -----
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application).
# redirect_uri must also be listed as an "Authorised redirect URI" on that client.
[auth]
redirect_uri = "https://planning-condition-tracker-cbovv39yhnquhj9a7jeefn.streamlit.app/oauth2callback"
cookie_secret = "a-long-random-string-generate-your-own"
client_id = "1234567890-xxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
